{
  "info": {
    "name": "API Citas Médicas y Pagos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "patientAId", "value": "" },
    { "key": "patientBId", "value": "" },
    { "key": "doctorPerezId", "value": "" },
    { "key": "doctorGomezId", "value": "" },
    { "key": "appointmentAId", "value": "" },
    { "key": "appointmentBId", "value": "" },
    { "key": "paymentId", "value": "" }
  ],
  "item": [
    {
      "name": "Preparación",
      "item": [
        {
          "name": "Listar médicos",
          "request": { "method": "GET", "url": "{{baseUrl}}/doctors" }
        },
        {
          "name": "Listar pacientes",
          "request": { "method": "GET", "url": "{{baseUrl}}/patients" }
        }
      ]
    },
    {
      "name": "Escenario 1 - disponibilidad",
      "item": [
        {
          "name": "Crear cita Dr. Pérez 10:00",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"patientId\":\"{{patientAId}}\",\"doctorId\":\"{{doctorPerezId}}\",\"startAt\":\"2026-09-23T10:00:00.000Z\",\"amount\":40}" },
            "url": "{{baseUrl}}/appointments"
          }
        },
        {
          "name": "Rechazar cita solapada (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"patientId\":\"{{patientBId}}\",\"doctorId\":\"{{doctorPerezId}}\",\"startAt\":\"2026-09-23T10:00:00.000Z\",\"amount\":40}" },
            "url": "{{baseUrl}}/appointments"
          }
        }
      ]
    },
    {
      "name": "Escenario 2 - pago consolidado",
      "item": [
        {
          "name": "Crear cita A 11:00",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"patientId\":\"{{patientAId}}\",\"doctorId\":\"{{doctorPerezId}}\",\"startAt\":\"2026-09-23T11:00:00.000Z\",\"amount\":40}" },
            "url": "{{baseUrl}}/appointments"
          }
        },
        {
          "name": "Crear cita B 14:00",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"patientId\":\"{{patientBId}}\",\"doctorId\":\"{{doctorGomezId}}\",\"startAt\":\"2026-09-23T14:00:00.000Z\",\"amount\":50}" },
            "url": "{{baseUrl}}/appointments"
          }
        },
        {
          "name": "Crear pago REF-MED-2026",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"appointmentIds\":[\"{{appointmentAId}}\",\"{{appointmentBId}}\"],\"paymentMethod\":\"TRANSFERENCIA\",\"bankReference\":\"REF-MED-2026\",\"amount\":90}" },
            "url": "{{baseUrl}}/payments"
          }
        },
        { "name": "Rechazar pago", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"reason\":\"Monto incompleto\"}" }, "url": "{{baseUrl}}/payments/{{paymentId}}/reject" } },
        { "name": "Aprobar pago corregido", "request": { "method": "PATCH", "url": "{{baseUrl}}/payments/{{paymentId}}/approve" } }
      ]
    },
    {
      "name": "Escenario 3 - ficha médica",
      "item": [
        {
          "name": "Rechazar ficha de cita no pagada (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"appointmentId\":\"{{appointmentAId}}\",\"reason\":\"Control\",\"diagnosis\":\"N/A\",\"treatment\":\"N/A\",\"attendedAt\":\"2026-09-23T11:30:00.000Z\"}" },
            "url": "{{baseUrl}}/medical-records"
          }
        },
        {
          "name": "Registrar ficha médica",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"appointmentId\":\"{{appointmentAId}}\",\"reason\":\"Dolor torácico\",\"diagnosis\":\"Evaluación cardiológica normal\",\"treatment\":\"Control en 30 días\",\"attendedAt\":\"2026-09-23T11:30:00.000Z\"}" },
            "url": "{{baseUrl}}/medical-records"
          }
        }
      ]
    }
  ]
}
